{
  "workflow": {
    "name": "Sermon Analyzer - Master Workflow",
    "version": "1.0.0",
    "mode": "hybrid",
    "triggers": [
      {
        "type": "webhook",
        "name": "manualTrigger"
      },
      {
        "type": "schedule",
        "name": "weeklyRun",
        "cron": "0 13 * * 1"
      }
    ],
    "stages": [
      {
        "id": "config_load",
        "type": "function",
        "version": "1.0",
        "description": "Load JSON config input",
        "output": "config"
      },
      {
        "id": "mode_router",
        "type": "switch",
        "version": "1.0",
        "description": "Route execution mode",
        "routes": ["single", "backfill", "discovery"]
      },
      {
        "id": "backfill_loader",
        "type": "function",
        "version": "1.0",
        "description": "Load explicit sermon list",
        "condition": "mode == backfill",
        "output": "sermonList"
      },
      {
        "id": "discovery_engine",
        "type": "function",
        "version": "1.0",
        "description": "Discover new sermons from sources",
        "condition": "mode == discovery",
        "output": "sermonList"
      },
      {
        "id": "dedupe_registry_check",
        "type": "function",
        "version": "1.0",
        "description": "Check registry for processed sermons",
        "output": "filteredSermonList"
      },
      {
        "id": "loop_sermons",
        "type": "loop",
        "version": "1.0",
        "description": "Process each sermon individually",
        "items": "filteredSermonList"
      },
      {
        "id": "ingestion",
        "type": "function",
        "version": "1.0",
        "description": "Download or access media",
        "output": "media"
      },
      {
        "id": "transcription",
        "type": "ai",
        "provider": "openai|whisper|other",
        "version": "1.0",
        "description": "Generate transcript",
        "output": "transcript"
      },
      {
        "id": "transcript_processing",
        "type": "function",
        "version": "1.0",
        "description": "Detect structure and markers",
        "output": "structuredTranscript"
      },
      {
        "id": "analysis",
        "type": "ai",
        "provider": "openai|claude",
        "version": "1.0",
        "description": "Analyze sermon structure and content",
        "output": "analysis"
      },
      {
        "id": "doctrine_check",
        "type": "function",
        "version": "1.0",
        "description": "Compare analysis to doctrine config",
        "output": "doctrineResult"
      },
      {
        "id": "output_generation",
        "type": "ai",
        "version": "1.0",
        "description": "Generate configured outputs",
        "output": "artifacts"
      },
      {
        "id": "artifact_storage",
        "type": "function",
        "version": "1.0",
        "description": "Save outputs to filesystem",
        "output": "storedArtifacts"
      },
      {
        "id": "registry_update",
        "type": "function",
        "version": "1.0",
        "description": "Update sermon registry",
        "output": "registryStatus"
      },
      {
        "id": "logging",
        "type": "function",
        "version": "1.0",
        "description": "Generate improvement log",
        "output": "log"
      }
    ]
  }
}
